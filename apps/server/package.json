{
  "name": "@payroll/server",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify API server (Node 22 LTS) — serves the built SPA in production.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e:serve": "tsx src/e2e/serve.ts",
    "create-admin": "tsx src/cli/create-admin.ts",
    "fix-legacy-paydates": "tsx src/cli/fix-legacy-paydates.ts",
    "backfill-legacy-ytd": "tsx src/cli/backfill-legacy-ytd.ts",
    "migrate:legacy": "tsx src/migrate/cli.ts",
    "gen-auth-sql": "tsx scripts/gen-better-auth-sql.ts",
    "seed": "tsx src/cli/seed.ts",
    "seed:qa": "tsx src/cli/seed-qa.ts"
  },
  "dependencies": {
    "@better-auth/utils": "~0.4.2",
    "@fastify/rate-limit": "~11.1.0",
    "@fastify/static": "~10.1.2",
    "@node-rs/argon2": "~2.0.2",
    "@payroll/db": "workspace:*",
    "@payroll/documents": "workspace:*",
    "@payroll/engine": "workspace:*",
    "@payroll/notifications": "workspace:*",
    "@payroll/shared": "workspace:*",
    "better-auth": "~1.6.25",
    "drizzle-orm": "~0.44.7",
    "fastify": "~5.6.0",
    "kysely": "^0.29.4",
    "kysely-postgres-js": "~3.0.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.3",
    "pino": "~9.9.0",
    "postgres": "~3.4.9",
    "zod": "~3.25.76",
    "zxcvbn": "~4.4.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "~0.5.4",
    "@types/node": "~22.18.13",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/zxcvbn": "^4.4.5",
    "@vitest/coverage-v8": "~3.2.7",
    "tsx": "~4.20.6",
    "typescript": "~5.9.2",
    "vitest": "~3.2.7"
  }
}
