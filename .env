# Payroll app — COMMITTED deployment environment (non-secret values only).
# Read by docker-compose.yml interpolation; Portainer GitOps picks it up from
# the repo on each redeploy. Secrets are NEVER here — they are files under
# /srv/payroll/secrets on the host (see SECRETS_HOST_DIR), mounted read-only.
# Local dev: copy .env.example instead (it documents every knob).

# --- Server ---
# Public base URL of the app behind the NPM proxy (spec 8). Used for setup
# links in invite/reset emails and Better Auth trusted origins.
BASE_URL=https://payroll.stabpablo.eu

# --- SMTP (notifications, spec 6/8) ---
# stack-ops docker-mailserver (container `mailserver`, public MTA for
# stabpablo.eu). Reached by public hostname from mcp_network — the same path
# mcp-email uses today. 587 = STARTTLS (SMTP_SECURE=false); 465 would be
# implicit TLS (SMTP_SECURE=true).
SMTP_HOST=mail.stabpablo.eu
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=payroll@stabpablo.eu
SMTP_FROM=payroll@stabpablo.eu
# SMTP password comes from $SECRETS_DIR/smtp-password — never an env var.

# --- Secrets directory (host side) ---
# Host dir compose mounts secret FILES from (db-password, smtp-password,
# encryption-key, session-secret). Only read by compose interpolation.
SECRETS_HOST_DIR=/srv/payroll/secrets
