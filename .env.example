# Payroll app — example environment. Copy to .env and fill in; never commit .env.
# Secrets are read as FILES from SECRETS_DIR (never as env values) — see spec 8.

# --- Server ---
# Port the Fastify server listens on (compose publishes 127.0.0.1:8989:8989)
PORT=8989
NODE_ENV=development
# pino log level: trace|debug|info|warn|error
LOG_LEVEL=info
# Display timezone for dates (DB stores TIMESTAMPTZ); Europe/Madrid per spec 1
APP_TZ=Europe/Madrid

# --- Secrets directory ---
# Directory containing secret FILES: db-password, smtp-password, encryption-key,
# session-secret. In compose: /run/secrets (mounted from /srv/payroll/secrets).
SECRETS_DIR=./secrets

# --- Database (dedicated Postgres 16, per spec 1/8) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payroll
DB_USER=payroll
# Password comes from $SECRETS_DIR/db-password — not an env var.

# --- SMTP (notifications, spec 6/8) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
# SMTP password comes from $SECRETS_DIR/smtp-password — not an env var.
