{
  "name": "@payroll/server",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify API server (Node 22 LTS) — serves the built SPA in production.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@payroll/engine": "workspace:*",
    "@payroll/shared": "workspace:*",
    "fastify": "~5.6.0",
    "pino": "~9.9.0"
  },
  "devDependencies": {
    "@types/node": "~22.18.0",
    "tsx": "~4.20.5",
    "typescript": "~5.9.2"
  }
}
