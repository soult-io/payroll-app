{
  "name": "@payroll/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Vendored payroll calculation engine (from stack-finance/mcp-accounting). Pure, deterministic, zero I/O.",
  "type": "module",
  "main": "./dist/payroll.js",
  "types": "./dist/payroll.d.ts",
  "exports": {
    ".": {
      "types": "./dist/payroll.d.ts",
      "import": "./dist/payroll.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "import": "./dist/money.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "vitest": "~3.2.4"
  }
}
