# Payroll app — example environment. Copy to .env (`cp .env.example .env`) and
# fill in what you need. Read by docker compose interpolation
# (compose.example.yml) and, in local dev, exported/sourced by you — the app
# itself reads env vars directly and secrets as FILES from SECRETS_DIR (never
# as env values). Full reference: docs/deployment.md.

# --- Server ---
# Port the Fastify server listens on — the container always uses 8927
# internally; PAYROLL_PORT below moves the host-side bind in compose.
PORT=8927
# Bind address (0.0.0.0 in containers).
HOST=0.0.0.0
NODE_ENV=development
# pino log level: trace|debug|info|warn|error
LOG_LEVEL=info
# Display timezone for dates (DB stores TIMESTAMPTZ); Europe/Madrid per spec 1
APP_TZ=Europe/Madrid
# Public base URL of the app (TLS terminates at your reverse proxy). Used for
# setup links in invite/reset emails and Better Auth trusted origins — in
# production this MUST be the public https:// URL.
BASE_URL=http://localhost:8927
# TOTP issuer — the app name shown in authenticator apps during enrollment.
TOTP_ISSUER=Payroll
# Deployment environment label (spec 14). "qa" shows the web "QA — synthetic
# data" banner and registers the QA-only /api/qa/mailbox endpoint; anything
# else (incl. unset) is normal production behavior. See docs/qa.md.
APP_ENV=
# Mailpit HTTP API — only used by the QA-only mailbox endpoint (APP_ENV=qa).
MAILPIT_URL=

# --- Secrets directory ---
# Directory containing secret FILES: db-password, smtp-password, encryption-key,
# session-secret, export-token (optional). In compose: /run/secrets (mounted
# from the host dir below). smtp-password is only needed when SMTP_USER is set.
SECRETS_DIR=./secrets
# Host-side directory compose mounts the secret files from (default ./secrets
# next to compose.example.yml). Only read by compose interpolation, not the app.
SECRETS_HOST_DIR=./secrets
# Host-side port the app is published on (127.0.0.1 only — proxy in front).
PAYROLL_PORT=8927

# --- Database (dedicated Postgres 16, per spec 1/8) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payroll
DB_USER=payroll
# Password comes from $SECRETS_DIR/db-password — not an env var.

# --- SMTP (notifications, spec 6/8) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
# STARTTLS vs implicit TLS: "true" = implicit TLS (typically port 465).
SMTP_SECURE=false
# EMAIL_MODE=log prints emails to the server log instead of sending (dev).
# Unset: smtp when SMTP_HOST is set, otherwise log.
EMAIL_MODE=
# SMTP password comes from $SECRETS_DIR/smtp-password — not an env var.

# --- Legacy migration (one-time cutover, spec 9 — see docs/cutover.md) ---
# Connection string for the LEGACY source database (legacy_accounting, accounting
# schema on the old stack). Only read by `pnpm migrate:legacy`; never by the
# running app. The target is the standard DB_* config above (or DATABASE_URL).
# Example: postgres://legacy:CHANGE-ME@legacy-db:5432/legacy_accounting
SOURCE_DATABASE_URL=
